# Select the non-secret config profile from app/core/config.ini.
# Use dev for Phase 2 and prod for Phase 3.
APP_ENV=dev

DB_USERNAME=postgres
DB_PASSWORD=replace-me

# Local can keep DB_HOST and DB_NAME empty to use app/database/database.ini.
# Deployment can set these connection values outside the codebase.
DB_HOST=
DB_NAME=
DB_PORT=

# Optional SSL override. Local PostgreSQL commonly uses disable;
# hosted PostgreSQL commonly uses require.
DB_SSLMODE=

# Leave empty for local testing without auth.
# Set in Azure and define the same token in the ESP32 secrets.h as DEVICE_API_TOKEN.
DEVICE_API_TOKEN=

# Optional dashboard/operator write token.
# When set, HITL review and settings updates require X-Operator-Token.
OPERATOR_API_TOKEN=

# Optional LLM reasoning layer for the agentic_ai strategy.
# Keep disabled unless OPENAI_API_KEY is configured in the runtime environment.
AGENTIC_AI_USE_LLM=false
OPENAI_API_KEY=

# Safe default: scheduled 10-minute LLM batch. The dashboard can persist a
# runtime override after an operator confirms the higher token usage.
FULL_AGENTIC_MODE_ENABLED=false

# Optional SMS alerts. Leave disabled/empty for local development.
SMS_NOTIFICATIONS_ENABLED=false
SMS_ALERT_COOLDOWN_SECONDS=900
SMS_RECEIVER_PHONE_NUMBER=09xxxxxxxxx
SMS_SENDER_ID=HANAS
SEMAPHORE_API_KEY=
SMS_STATUS_POLL_INTERVAL_SECONDS=60
SMS_STATUS_POLL_BATCH_SIZE=20
SMS_STATUS_MAX_CHECKS=10
SMS_STATUS_LOOKBACK_DAYS=30

# Optional human-in-the-loop review gate for agentic_ai dosing.
# When true, agentic_ai pump commands wait for operator approval/override.
HUMAN_IN_THE_LOOP_ENABLED=false
